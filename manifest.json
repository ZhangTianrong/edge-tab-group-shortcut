{
  "manifest_version": 3,
  "name": "TabGroup Keyboard Shortcuts",
  "version": "1.0",
  "key": "",
  "description": "Windows-only hovered tab-group shortcuts for Edge. Requires a separate native companion install.",
  "homepage_url": "https://github.com/ZhangTianrong/edge-tab-group-shortcut",
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "TabGroup Shortcut Help"
  },
  "commands": {
    "close-group-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Close all tabs in hovered group"
    },
    "close-other-groups": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Close all groups except hovered group"
    }
  }
}
